<UserControl x:Class="Pasjans.View.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pasjans.View"
             xmlns:vm="clr-namespace:Pasjans.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Styl dla kart -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <!-- Szablon dla wyświetlania karty -->
        <DataTemplate x:Key="CardTemplate">
            <Border Style="{StaticResource CardStyle}">
                <Image Source="{Binding ImageSource}" Stretch="Fill"/>
            </Border>
        </DataTemplate>

        <!-- Konwerter do warunków w widoku -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#006400">
        <!-- Zielone tło jak na stole do kart -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Górny panel z przyciskami -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Nowa Gra" Command="{Binding RestartGameCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Auto Ruch" Command="{Binding AutoMoveCommand}" Margin="5" Padding="10,5"/>
            <TextBlock Text="{Binding GameStatus}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="White"/>
        </StackPanel>

        <!-- Panel z talią i foundacją -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Talia do dobierania -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="#004400">
                <Button Command="{Binding DrawCardCommand}" Opacity="0.01"/>
            </Border>
            <ContentControl Grid.Column="0" Content="{Binding TopDrawPileCard}" ContentTemplate="{StaticResource CardTemplate}"/>

            <!-- Stos odrzuconych -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,2,2,2"/>
            <ContentControl Grid.Column="1" Content="{Binding TopDiscardPileCard}" ContentTemplate="{StaticResource CardTemplate}" Margin="10,2,2,2"/>

            <!-- Miejsca na foundację (Asy) -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Background="#004400" Margin="40,2,2,2"/>
            <ItemsControl Grid.Column="3" ItemsSource="{Binding FoundationPiles[0]}" Margin="40,2,2,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardTemplate}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Background="#004400"/>
            <ItemsControl Grid.Column="4" ItemsSource="{Binding FoundationPiles[1]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardTemplate}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="5" Style="{StaticResource CardStyle}" Background="#004400"/>
            <ItemsControl Grid.Column="5" ItemsSource="{Binding FoundationPiles[2]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardTemplate}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Background="#004400"/>
            <ItemsControl Grid.Column="6" ItemsSource="{Binding FoundationPiles[3]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardTemplate}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Panel z 10 stosami gry (tableau) -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TableauPiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="90" Height="Auto" Margin="5" Background="#004400" BorderBrush="Transparent" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Margin="0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardTemplate}" Margin="0,-80,0,0">
                                            <ContentControl.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.MoveCardCommand, 
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl, 
                                                                                       AncestorLevel=2}}"/>
                                            </ContentControl.InputBindings>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Panel z komunikatem o wygranej -->
        <Border Grid.Row="3" Background="#333333" BorderBrush="Gold" BorderThickness="2" 
                Visibility="{Binding IsGameWon, Converter={StaticResource BoolToVis}}" 
                Margin="100" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="GRATULACJE! WYGRAŁEŚ!" FontSize="24" Foreground="Gold" HorizontalAlignment="Center"/>
                <Button Content="Zagraj ponownie" Command="{Binding RestartGameCommand}" 
                        Margin="10" Padding="10,5" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>